// Prisma 7: connection URL is configured in prisma.config.ts (env DATABASE_URL).
// The `url` field is not allowed in this file — see https://pris.ly/d/config-datasource

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PaymentMethod {
  CASH
  AIRTEL_MONEY
  MPESA
  TIGO_PESA
  BANK
}

enum OrderStatus {
  COMPLETED
  PENDING
  CANCELLED
}

enum DebtStatus {
  OPEN
  SETTLED
}

model Business {
  id           String   @id @default(uuid())
  name         String
  uniqueCode   String   @unique
  passwordHash String
  isActive     Boolean  @default(true)
  /** Monotonic counter for customer receipts (RCT-000001). */
  lastReceiptSequence Int      @default(0)
  /** POS receipt width (mm), 50–60 typical for thermal rolls. */
  receiptPaperWidthMm  Int      @default(58)
  /** If true, browser print dialog opens after a completed sale (when receipt is shown). */
  printReceiptAfterSale Boolean @default(true)
  /** Optional note: e.g. printer IP:9100 for staff reference (browser cannot open raw TCP). */
  receiptPrinterAddress String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  categories  Category[]
  items       Item[]
  customers   Customer[]
  orders      Order[]
  payments    Payment[]
  restockLogs RestockLog[]
}

model Category {
  id         String   @id @default(cuid())
  name       String
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  items      Item[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([businessId, name])
}

model Item {
  id                String   @id @default(cuid())
  name              String
  /** Free-form unit label (e.g. pcs, m, cm, mm, kg, g, box). */
  unit              String   @default("pcs")
  categoryId        String
  category          Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  buyingPrice       Decimal  @db.Decimal(14, 2)
  sellingPrice      Decimal  @db.Decimal(14, 2)
  quantity          Decimal  @db.Decimal(18, 6)
  lowStockThreshold Decimal  @db.Decimal(18, 6) @default(10)
  businessId        String
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orderItems        OrderItem[]
  restockLogs       RestockLog[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([businessId])
  @@index([categoryId])
}

model RestockLog {
  id         String   @id @default(cuid())
  itemId     String
  item       Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  quantity   Decimal  @db.Decimal(18, 6)
  notes      String?
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([businessId])
  @@index([itemId])
}

model Customer {
  id         String   @id @default(cuid())
  name       String
  phone      String
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orders     Order[]
  debts      Debt[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([businessId, phone])
  @@index([businessId])
}

model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique
  /** Sequential customer receipt id per business, e.g. RCT-000001 */
  receiptNumber String?
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  businessId    String
  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  totalAmount   Decimal       @db.Decimal(14, 2)
  amountPaid    Decimal       @db.Decimal(14, 2)
  balance       Decimal       @db.Decimal(14, 2)
  paymentMethod PaymentMethod
  status        OrderStatus   @default(COMPLETED)
  orderItems    OrderItem[]
  payments      Payment[]
  debt          Debt?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([businessId])
  @@index([customerId])
}

model OrderItem {
  id            String  @id @default(cuid())
  orderId       String
  order         Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId        String
  item          Item    @relation(fields: [itemId], references: [id], onDelete: Restrict)
  quantity      Decimal @db.Decimal(18, 6)
  unitBuyPrice  Decimal @db.Decimal(14, 2)
  unitSellPrice Decimal @db.Decimal(14, 2)
  lineTotal     Decimal @db.Decimal(14, 2)
  lineProfit    Decimal @db.Decimal(14, 2)

  @@index([orderId])
  @@index([itemId])
}

model Payment {
  id         String        @id @default(cuid())
  orderId    String?
  order      Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  amount     Decimal       @db.Decimal(14, 2)
  method     PaymentMethod
  businessId String
  business   Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  note       String?
  createdAt  DateTime      @default(now())

  @@index([orderId])
  @@index([businessId])
}

model Debt {
  id         String     @id @default(cuid())
  orderId    String     @unique
  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  amount     Decimal    @db.Decimal(14, 2)
  status     DebtStatus @default(OPEN)
  settledAt  DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([customerId])
  @@index([status])
}
