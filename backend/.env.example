# PostgreSQL (Supabase, Render, or local)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# JWT signing secret (use a long random string in production)
JWT_SECRET="change-me-to-a-long-random-string"

# Super admin (not stored in DB; single login via /auth/login)
SUPER_ADMIN_ID="S7-0000"
SUPER_ADMIN_PASSWORD="change-me-strong-password"

# API port (Render sets PORT automatically)
PORT=3001

# Comma-separated origins for browser requests (your Vercel URL + local)
CORS_ORIGIN="http://localhost:3000"
