# Server port (Render/Heroku inject PORT automatically)
PORT=5000

# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# JWT signing secret — use a long random string in production
JWT_SECRET="your_secret"

# Super admin — not stored in DB; login via POST /api/auth/login
SUPER_ADMIN_ID=S7-0000
SUPER_ADMIN_PASSWORD=admin123

# Comma-separated allowed frontend origins. Use * only if you understand the trade-offs.
# If unset on Render/production, the API reflects the browser Origin (works with Vercel).
# Tighter security:
# CORS_ORIGIN="https://your-app.vercel.app"
CORS_ORIGIN="http://localhost:3000"
